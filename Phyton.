import matplotlib.pyplot as plt

# Data sederhana
hari = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat']
suhu = [30, 32, 31, 29, 28]

# Membuat grafik garis
plt.plot(hari, suhu, marker='o', color='skyblue', linestyle='-')

# Menambahkan judul dan label
plt.title('Grafik Suhu Harian')
plt.xlabel('Hari')
plt.ylabel('Suhu (°C)')

# Menampilkan grafik
plt.grid(True)
plt.tight_layout()
plt.show()
